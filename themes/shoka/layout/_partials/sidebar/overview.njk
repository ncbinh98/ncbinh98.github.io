<div class="author" itemprop="author" itemscope itemtype="http://schema.org/Person">
  <img class="image" itemprop="image" alt="{{ author }}"
      data-src="{{ url_for(theme.statics + theme.images + '/'+ theme.sidebar.avatar) }}">
  <p class="name" itemprop="name">{{ author }}</p>
  <div class="description" itemprop="description">{{ description }}</div>
</div>

<nav class="state">
  {%- if config.archive_dir != '/' and site.posts.length > 0 %}
    <div class="item posts">
      <a href="{{ url_for(config.archive_dir + '/') }}">
        <span class="count">{{ site.posts.length }}</span>
        <span class="name">{{ __('state.posts') }}</span>
      </a>
    </div>
  {%- endif %}

  {%- if config.category_dir != '/' and site.categories.length > 0 %}
    <div class="item categories">
      <a href="{{ url_for(config.category_dir + '/')}}">
        <span class="count">{{ site.categories.length }}</span>
        <span class="name">{{ __('state.categories') }}</span>
      </a>
    </div>
  {%- endif %}

  {%- if config.tag_dir != '/' and site.tags.length > 0 %}
    <div class="item tags">
      <a href="{{ url_for(config.tag_dir + '/') }}">
        <span class="count">{{ site.tags.length }}</span>
        <span class="name">{{ __('state.tags') }}</span>
      </a>
    </div>
  {%- endif %}
</nav>

<div class="social">
  {%- for name, link in theme.social %}
    {%- set sidebarURL = link.split('||')[0] | trim %}
    {%- set sidebarIcon = '<i class="ic i-' + link.split('||')[1] | trim + '"></i>' %}
      {{ _url(sidebarURL, sidebarIcon, {title: sidebarURL, class: 'item ' + name}) }}
  {%- endfor %}
</div>

<ul class="menu">
  {{ partial('_partials/sidebar/menu.njk', {}, {cache: true}) }}
</ul>

<style>
.overview .menu .item.lang-switch:hover .submenu,
#nav .menu .item.lang-switch:hover .submenu { display: none; }
.overview .menu .item.lang-switch.expand .submenu,
#nav .menu .item.lang-switch.expand .submenu { display: block; }
#nav .menu .item.lang-switch > a { cursor: pointer; }
#nav .menu .item.lang-switch > a:focus-visible { outline: 2px solid var(--color-pink); outline-offset: 2px; }
</style>
<script>
(function () {
  var doc = document;
  var closeAll = function () {
    doc.querySelectorAll('.lang-switch.expand').forEach(function (li) {
      li.classList.remove('expand');
      var a = li.querySelector('a[aria-expanded]');
      if (a) a.setAttribute('aria-expanded', 'false');
    });
  };
  doc.addEventListener('click', function (e) {
    var trigger = e.target.closest('.lang-switch > a[aria-haspopup]');
    if (trigger) {
      e.preventDefault();
      var li = trigger.parentNode;
      var open = li.classList.toggle('expand');
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      return;
    }
    closeAll();
  });
  doc.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' || e.key === ' ') {
      var trigger = e.target.closest('.lang-switch > a[aria-haspopup]');
      if (trigger) {
        e.preventDefault();
        trigger.click();
      }
    } else if (e.key === 'Escape') {
      closeAll();
    }
  });
})();
</script>
